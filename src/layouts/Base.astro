---
import "../styles/global.css";
import "@fontsource/big-shoulders-display/latin-700";
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/outfit/latin-400";
import "@fontsource/outfit/latin-500";
import "@fontsource/outfit/latin-600";
import "@fontsource/outfit/latin-700";
import "@fontsource/newsreader/latin-400";
import "@fontsource/newsreader/latin-500";
import "@fontsource/newsreader/latin-600";
import "@fontsource/ibm-plex-mono/latin-400";
import "@fontsource/ibm-plex-mono/latin-500";
import SnapshotSwitch from "../components/SnapshotSwitch.astro";
import { allSnapshots } from "../lib/snapshots";
import { disinfoPath } from "../lib/dates";
import {
  DEFAULT_OG_IMAGE,
  OG_HEIGHT,
  OG_WIDTH,
  SITE_NAME,
  absoluteUrl,
  clip,
} from "../lib/share";

interface Props {
  title: string;
  description: string;
  snapshotId?: string;
  /** Title for link previews. Defaults to the page title. */
  shareTitle?: string;
  /** Site path of the 1200x630 preview image. Defaults to the site-wide image. */
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  /** Canonical path. Defaults to the current path. */
  canonicalPath?: string;
}

const { title, description: rawDescription, snapshotId, shareTitle, image, imageAlt, ogType = "website", canonicalPath } =
  Astro.props;
const description = clip(rawDescription, 200);
const snapshots = await allSnapshots();
const latest = snapshots[0];
if (!latest) {
  throw new Error("No snapshots found.");
}
const active = snapshots.find((entry) => entry.data.id === snapshotId) ?? latest;
const fullTitle = title.includes("TDDR") ? title : `${title} · TDDR Narrative Tracker`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const narrativesHref = active.data.id === latest.data.id ? "/" : `/snapshots/${active.data.id}`;
const disinfoHref = disinfoPath(active.data.id);
const narrativesCurrent =
  path === narrativesHref ||
  path === `/snapshots/${active.data.id}` ||
  path.startsWith(`/snapshots/${active.data.id}/narratives`);
const canonical = absoluteUrl(canonicalPath ?? (path === "/" ? "/" : path));
const ogTitle = shareTitle ?? (title.includes("TDDR") ? title : `${title} · ${SITE_NAME}`);
const ogImage = absoluteUrl(image ?? DEFAULT_OG_IMAGE);
const ogImageAlt = imageAlt ?? `${SITE_NAME}: rising opposition narratives from the Right and the Far Left.`;
const disinfoCurrent = path === disinfoHref || (active.data.id === latest.data.id && path === "/disinfo");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("tddr-theme");
          var theme = stored === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#fff4cc" : "#121212");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">TDDR</span>
          <span>
            <span class="brand-name">Narrative Tracker</span>
            <span class="brand-sub">Too Dumb Didn't Read</span>
          </span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href={narrativesHref} aria-current={narrativesCurrent ? "page" : undefined}>Narratives</a>
          <a href="/narratives">History</a>
          <a href={disinfoHref} aria-current={disinfoCurrent ? "page" : undefined}>Disinformation</a>
          <a href="/about" aria-current={path === "/about" ? "page" : undefined}>Methodology</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light mode">
          <span class="when-dark">Light mode</span>
          <span class="when-light">Dark mode</span>
        </button>
        <p class="stamp">Updated {active.data.updatedLabel}</p>
        <SnapshotSwitch activeId={active.data.id} />
      </div>
    </header>
    <main id="content" class="page">
      <div class="shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div>
          <p><strong>TDDR Narrative Tracker</strong></p>
          <p>Too Dumb Didn't Read. A research snapshot, not a live feed.</p>
          <p>Updated {active.data.updatedLabel}.</p>
        </div>
        <div>
          <p><a href="/about">How the momentum score is built</a></p>
          <p><a href={disinfoHref}>Fact-checked claims</a></p>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const meta = document.querySelector('meta[name="theme-color"]');

      function paint() {
        const dark = document.documentElement.getAttribute("data-theme") !== "light";
        if (!button) return;
        button.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        meta?.setAttribute("content", dark ? "#121212" : "#fff4cc");
      }

      paint();
      button?.addEventListener("click", () => {
        const next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("tddr-theme", next);
        paint();
      });
    </script>
  </body>
</html>
