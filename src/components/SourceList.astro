---
import type { SourceLink } from "../data/schema";

interface Props {
  links: SourceLink[];
  numbered?: boolean;
}

const { links, numbered = false } = Astro.props;
---

<ol class:list={["source-list", { numbered }]}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noreferrer noopener">
          {link.title}
        </a>
        {link.site || link.date ? (
          <p class="source-meta">{[link.site, link.date].filter(Boolean).join(" · ")}</p>
        ) : null}
      </li>
    ))
  }
</ol>
