---
import { ChevronDown, Sparkles, TrendingUp, CircleOff } from "lucide-react";
import { historyPath, snapshotShortLabel, whatsNew, RISER_RULES } from "../../lib/history";
import type { WhatsNewItem } from "../../lib/history";
import { narrativeHistory } from "../../lib/snapshots";
import { fmt } from "../../lib/format";
import { shortTitle, stripNewPrefix } from "../../lib/share";

interface Props {
  snapshotId: string;
}

const { snapshotId } = Astro.props;
const index = await narrativeHistory();
const diff = whatsNew(index, snapshotId);
const total = diff.fresh.length + diff.risers.length + diff.gone.length;
const MAX = 5;
const cols: { key: string; label: string; Icon: typeof Sparkles; tone: string; items: WhatsNewItem[]; empty: string }[] = [
  { key: "new", label: "New on the board", Icon: Sparkles, tone: "text-pop", items: diff.fresh, empty: "No new cards." },
  { key: "risers", label: "Big risers", Icon: TrendingUp, tone: "text-warn", items: diff.risers, empty: "No big moves." },
  { key: "gone", label: "Dropped off", Icon: CircleOff, tone: "text-muted-foreground", items: diff.gone, empty: "Nothing dropped off." },
];
const dot = (side: string) => (side === "Right" ? "bg-side-right" : "bg-side-left");
function metric(item: WhatsNewItem): string {
  if (item.kind === "riser") {
    const dm = item.momentum - (item.prevMomentum ?? 0);
    const posts = item.prevPosts24h ? ` · ${((item.posts24h ?? 0) / item.prevPosts24h).toFixed(1)}× posts` : "";
    return `${item.prevMomentum}→${item.momentum} (${dm >= 0 ? "+" : ""}${dm})${posts}`;
  }
  if (item.kind === "gone") return `was ${item.momentum}`;
  return `${item.kind === "back" ? "back · " : ""}${item.momentum}`;
}
---

<section class="mb-8" aria-label="What's new since the previous snapshot">
  <details data-whats-new class="group rounded-xl border border-primary/25 bg-card">
    <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:px-5">
      <span class="font-display text-lg font-extrabold uppercase tracking-wide">What's new</span>
      <span class="font-mono text-[0.7rem] uppercase tracking-widest text-muted-foreground">
        {diff.previousId ? `vs ${snapshotShortLabel(diff.previousId)}` : "first snapshot"}
      </span>
      <span class="ml-auto flex items-center gap-3 font-mono text-xs">
        {
          diff.previousId ? <span class="text-pop">{diff.fresh.length} new</span> : null
        }
        {
          diff.previousId ? <span class="text-warn">{diff.risers.length} rising</span> : null
        }
        {
          diff.previousId ? <span class="text-muted-foreground">{diff.gone.length} dropped</span> : null
        }
        <ChevronDown className="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
      </span>
    </summary>
    <div class="border-t px-4 py-4 sm:px-5">
      {
        !diff.previousId ? (
          <p class="text-sm text-muted-foreground">This is the first snapshot in the archive, so there is nothing to compare it with yet.</p>
        ) : total === 0 ? (
          <p class="text-sm text-muted-foreground">
            No changes since {snapshotShortLabel(diff.previousId)}: the same narratives are on the board and none moved {RISER_RULES.momentumDelta}+ points.
          </p>
        ) : (
          <div class="grid gap-5 sm:grid-cols-3 sm:gap-6">
            {cols.map((c) => {
              const Icon = c.Icon;
              return (
              <div class="min-w-0">
                <p class={`mb-2 flex items-center gap-1.5 font-mono text-[0.68rem] uppercase tracking-widest ${c.tone}`}>
                  <Icon className="size-3.5" /> {c.label}
                </p>
                {c.items.length === 0 ? (
                  <p class="text-xs text-muted-foreground">{c.empty}</p>
                ) : (
                  <ul class="flex flex-col gap-1.5">
                    {c.items.slice(0, MAX).map((item) => (
                      <li>
                        <a href={historyPath(item.slug)} class="group/item flex items-baseline gap-2 text-sm" title={stripNewPrefix(item.title)}>
                          <span class={`size-1.5 shrink-0 translate-y-[-2px] rounded-full ${dot(item.side)}`} aria-hidden="true" />
                          <span class={`min-w-0 truncate font-medium group-hover/item:text-primary ${item.kind === "gone" ? "text-muted-foreground line-through decoration-muted-foreground/40" : ""}`}>
                            {shortTitle(stripNewPrefix(item.title))}
                          </span>
                          <span class="ml-auto shrink-0 font-mono text-[0.7rem] text-muted-foreground">{metric(item)}</span>
                        </a>
                      </li>
                    ))}
                    {c.items.length > MAX ? <li class="font-mono text-[0.7rem] text-muted-foreground">+{c.items.length - MAX} more</li> : null}
                  </ul>
                )}
              </div>
              );
            })}
          </div>
        )
      }
      <p class="mt-4 text-[0.7rem] text-muted-foreground">
        Big riser = +{RISER_RULES.momentumDelta} momentum points or more, or 24h X posts at least doubled to {fmt(RISER_RULES.postsFloor)}+. Items open the narrative's full history.
      </p>
    </div>
  </details>
</section>

<script>
  // Open on tablet and desktop; stay collapsed on phones.
  const wide = window.matchMedia("(min-width: 640px)");
  for (const el of document.querySelectorAll<HTMLDetailsElement>("details[data-whats-new]")) {
    if (wide.matches) el.open = true;
  }
</script>
