---
import { ArrowLeft, ArrowDownRight, ArrowUpRight, Minus, CircleOff } from "lucide-react";
import type { HistoryIndex, NarrativeHistory } from "../../lib/history";
import { snapshotShortLabel, STATUS_LABEL } from "../../lib/history";
import { Card, CardContent } from "../ui/card";
import { Badge } from "../ui/badge";
import HistoryChart from "./HistoryChart";
import MatchingNote from "./MatchingNote.astro";
import { MomentumScore, NewBadge, SideBadge, StatusBadge } from "./bits";
import { fmt } from "../../lib/format";
import { narrativePath } from "../../lib/dates";
import { longEditionLabel, stripNewPrefix } from "../../lib/share";

interface Props {
  history: NarrativeHistory;
  index: HistoryIndex;
}

const { history: h, index } = Astro.props;
const latestIndex = index.snapshots.length - 1;
const n = h.appearances.length;
const end = h.current ? latestIndex : Math.min(h.last.index + 1, latestIndex);
const byIndex = new Map(h.appearances.map((a) => [a.index, a]));
// Timeline rows, newest first: every snapshot from first sighting to now (or to the drop-off).
const rows = [] as { index: number; id: string }[];
for (let i = end; i >= h.first.index; i -= 1) rows.push({ index: i, id: index.snapshots[i].id });
const dt = "font-mono text-[0.68rem] uppercase tracking-widest text-muted-foreground";
const statusLine = h.current
  ? `${STATUS_LABEL[h.status]} · on the board in the latest snapshot`
  : `Off the board since ${snapshotShortLabel(index.snapshots[Math.min(h.last.index + 1, latestIndex)].id)}`;
---

<nav class="mb-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Breadcrumb">
  <a href="/narratives" class="-ml-2 inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
    <ArrowLeft className="size-4" /> All tracked narratives
  </a>
  <span class="text-muted-foreground/50">/</span>
  <span class="font-mono text-xs text-muted-foreground">History</span>
</nav>

<header class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center gap-2">
    <SideBadge side={h.side} />
    {h.isNew ? <NewBadge /> : null}
    <StatusBadge status={h.status} />
    <Badge variant="outline">{n} snapshot{n === 1 ? "" : "s"}</Badge>
  </div>
  <h1 class="max-w-5xl text-balance font-display text-4xl font-extrabold uppercase leading-[0.92] tracking-tight sm:text-6xl">
    {stripNewPrefix(h.title)}
  </h1>
  <p class="font-mono text-xs text-muted-foreground">
    Tracked {snapshotShortLabel(h.first.snapshotId)} → {h.current ? `now (${snapshotShortLabel(h.last.snapshotId)})` : snapshotShortLabel(h.last.snapshotId)} · {statusLine}
  </p>
</header>

<section class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4" aria-label="Key moments">
  <Card className="gap-2 py-4">
    <CardContent className="flex flex-col gap-1.5 px-4">
      <span class={dt}>First seen</span>
      <span class="font-display text-3xl font-extrabold uppercase leading-none">{snapshotShortLabel(h.first.snapshotId)}</span>
      <span class="text-xs text-muted-foreground">Entered at {h.first.momentum} · #{h.first.rank} of {h.first.total}</span>
    </CardContent>
  </Card>
  <Card className="gap-2 border-primary/40 py-4">
    <CardContent className="flex flex-col gap-1.5 px-4">
      <span class={dt}>Peak</span>
      <span class="flex items-baseline gap-2"><MomentumScore value={h.peak.momentum} className="text-4xl text-primary" /><span class="font-display text-xl font-extrabold uppercase">{snapshotShortLabel(h.peak.snapshotId)}</span></span>
      <span class="text-xs text-muted-foreground">{fmt(h.peak.posts24h)} X posts in 24h</span>
    </CardContent>
  </Card>
  <Card className="gap-2 py-4">
    <CardContent className="flex flex-col gap-1.5 px-4">
      <span class={dt}>{h.current ? "Now" : "Last seen"}</span>
      <span class="flex items-baseline gap-2"><MomentumScore value={h.last.momentum} className="text-4xl" /><span class="font-display text-xl font-extrabold uppercase">{snapshotShortLabel(h.last.snapshotId)}</span></span>
      <span class="text-xs text-muted-foreground">{h.last.momentum - h.peak.momentum === 0 ? "At its peak" : `${h.last.momentum - h.peak.momentum} from peak`}</span>
    </CardContent>
  </Card>
  <Card className="gap-2 py-4">
    <CardContent className="flex flex-col gap-1.5 px-4">
      <span class={dt}>Status</span>
      <span class="font-display text-3xl font-extrabold uppercase leading-none">{STATUS_LABEL[h.status]}</span>
      <span class="text-xs text-muted-foreground">{n} of {index.snapshots.length - h.first.index} snapshots since first seen</span>
    </CardContent>
  </Card>
</section>

<Card className="mt-6 gap-3 px-3 sm:px-5">
  <div class="flex flex-wrap items-center justify-between gap-2 px-2 sm:px-0">
    <h2 class="font-display text-2xl font-extrabold uppercase tracking-wide">Momentum, snapshot by snapshot</h2>
    <span class="flex items-center gap-3 font-mono text-[0.68rem] uppercase tracking-wider text-muted-foreground">
      <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full border-2 border-primary"></span> Peak</span>
      <span class="flex items-center gap-1.5"><span class="size-2 rounded-full border border-muted-foreground"></span> Off the board</span>
    </span>
  </div>
  <div class="hidden sm:block"><HistoryChart history={h} snapshots={index.snapshots} /></div>
  <div class="sm:hidden"><HistoryChart history={h} snapshots={index.snapshots} narrow /></div>
</Card>

<section class="mt-10" aria-labelledby="timeline">
  <h2 id="timeline" class="mb-4 font-display text-2xl font-extrabold uppercase tracking-wide">Timeline</h2>
  <ol class="relative flex flex-col gap-2 border-l border-border pl-5 sm:pl-6">
    {
      rows.map(({ index: i, id }) => {
        const a = byIndex.get(i);
        const prev = a ? h.appearances[h.appearances.indexOf(a) - 1] : undefined;
        const delta = a && prev ? a.momentum - prev.momentum : null;
        if (!a) {
          return (
            <li class="relative">
              <span class="absolute -left-[1.6rem] top-3 size-2.5 rounded-full border border-muted-foreground bg-background sm:-left-[1.85rem]" />
              <div class="flex flex-wrap items-center gap-2 rounded-lg border border-dashed px-4 py-2.5 text-sm text-muted-foreground">
                <CircleOff className="size-4" />
                <span class="font-mono text-xs">{longEditionLabel(id)}</span>
                <span>{i > h.last.index ? "Dropped off the board" : "Not on the board"}</span>
              </div>
            </li>
          );
        }
        const isPeak = a === h.peak;
        return (
          <li class="relative">
            <span class={`absolute -left-[1.65rem] top-4 size-3 rounded-full sm:-left-[1.9rem] ${isPeak ? "bg-primary ring-4 ring-primary/25" : h.side === "Right" ? "bg-side-right" : "bg-side-left"}`} />
            <a href={narrativePath(a.snapshotId, a.slug)} class="group grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 rounded-lg border bg-card px-4 py-3 transition-colors hover:border-primary/50">
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs text-muted-foreground">{longEditionLabel(a.snapshotId)}</span>
                {a === h.first ? <Badge variant="outline">First seen</Badge> : null}
                {isPeak ? <Badge variant="accent">Peak</Badge> : null}
              </span>
              <span class="row-span-2 flex flex-col items-end">
                <MomentumScore value={a.momentum} className="text-3xl" />
                {delta === null ? (
                  <span class="font-mono text-[0.7rem] text-muted-foreground">entry</span>
                ) : (
                  <span class={`inline-flex items-center gap-0.5 font-mono text-[0.7rem] ${delta > 0 ? "text-warn" : delta < 0 ? "text-muted-foreground" : "text-primary"}`}>
                    {delta > 0 ? <ArrowUpRight className="size-3" /> : delta < 0 ? <ArrowDownRight className="size-3" /> : <Minus className="size-3" />}
                    {delta > 0 ? `+${delta}` : delta}
                  </span>
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold leading-snug group-hover:text-primary">{stripNewPrefix(a.title)}</span>
                <span class="font-mono text-[0.7rem] text-muted-foreground">#{a.rank} of {a.total} · {fmt(a.posts24h)} posts/24h · {a.accel >= 10 ? Math.round(a.accel) : a.accel.toFixed(1)}× pace{a.slug !== h.slug ? ` · slug "${a.slug}"` : ""}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
  {n === 1 ? <p class="mt-4 text-sm text-muted-foreground">Seen in one snapshot so far, so there is no arc yet. The chart fills in as the 7 AM and 5 PM snapshots come in.</p> : null}
</section>

<div class="mt-10"><MatchingNote /></div>
