---
import { ArrowLeft, ArrowRight, ExternalLink, Megaphone, Quote, Target, Users, ShieldAlert, Search } from "lucide-react";
import type { Narrative, Snapshot } from "../../data/schema";
import { Card, CardContent, CardHeader, CardTitle } from "../ui/card";
import { Badge } from "../ui/badge";
import { Separator } from "../ui/separator";
import { Progress } from "../ui/progress";
import StoryCharts from "./StoryCharts";
import { MomentumBar, MomentumScore, NewBadge, SideBadge, Sparkline, TrendBadge, TrendInline } from "./bits";
import { fmt } from "../../lib/format";
import { dashboardPath, narrativePath } from "../../lib/dates";
import { editionLabel, isNewNarrative, stripNewPrefix } from "../../lib/share";
import { allSnapshots, narrativeHistory } from "../../lib/snapshots";
import { historyPath } from "../../lib/history";
import { History } from "lucide-react";

interface Props {
  snapshot: Snapshot;
  narrative: Narrative;
  rank: number;
  total: number;
  higher: Narrative | null;
  lower: Narrative | null;
}

const { snapshot, narrative: n, rank, total, higher, lower } = Astro.props;
const latestId = (await allSnapshots())[0]?.data.id ?? snapshot.id;
const desk = dashboardPath(snapshot.id, latestId);
const isNew = isNewNarrative(n);
const historyIndex = await narrativeHistory();
const historySlug = historyIndex.canonical.get(n.id) ?? n.id;
const thread = historyIndex.bySlug.get(historySlug);

function ratingVariant(rating: string): "danger" | "warning" | "accent" {
  const r = rating.toLowerCase();
  if (/false|fabricat|pants|wrong|no evidence|unsupported/.test(r)) return "danger";
  if (/mislead|missing|mixed|half|lacks|exagger|out of context|unproven/.test(r)) return "warning";
  return "accent";
}

const parts = [
  { label: "Volume", value: n.volumeIndex },
  { label: "Acceleration", value: n.accelIndex },
  { label: "Coverage", value: n.coverageIndex },
];
const h2 = "font-display text-2xl font-extrabold uppercase tracking-wide";
const dt = "font-mono text-[0.68rem] uppercase tracking-widest text-muted-foreground";
---

<nav class="mb-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Breadcrumb">
  <a href={`${desk}#feed`} class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 -ml-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
    <ArrowLeft className="size-4" /> All narratives
  </a>
  <span class="text-muted-foreground/50">/</span>
  <span class="font-mono text-xs text-muted-foreground">{editionLabel(snapshot.id)}</span>
  <a href={historyPath(historySlug)} class="ml-auto inline-flex items-center gap-1.5 rounded-md border border-primary/40 px-2.5 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground">
    <History className="size-3.5" /> Full history{thread ? ` · ${thread.appearances.length} snapshot${thread.appearances.length === 1 ? "" : "s"}` : ""}
  </a>
</nav>

<header class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center gap-2">
    <SideBadge side={n.side} />
    {isNew ? <NewBadge /> : null}
    <TrendBadge accel={n.accel} />
    {n.trendingUS ? <Badge variant="accent">Trending on X</Badge> : null}
    <Badge variant="outline">#{rank} of {total}</Badge>
  </div>
  <h1 class="max-w-5xl font-display text-4xl font-extrabold uppercase leading-[0.92] tracking-tight text-balance sm:text-6xl lg:text-7xl">
    {stripNewPrefix(n.title)}
  </h1>
  <p class="font-mono text-xs text-muted-foreground">{snapshot.updatedLabel}</p>
</header>

<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-10">
  <aside class="lg:order-2" aria-label="Momentum">
    <div class="flex flex-col gap-4 lg:sticky lg:top-36">
      <Card className="gap-4 border-primary/30 py-5">
        <CardHeader className="gap-1">
          <span class={dt}>Momentum score</span>
          <div class="flex items-end justify-between gap-3">
            <div class="flex items-baseline gap-1.5">
              <MomentumScore value={n.momentum} className="text-7xl text-primary" />
              <span class="font-mono text-xs text-muted-foreground">/100</span>
            </div>
            <Sparkline points={n.daily} side={n.side} width={110} height={42} />
          </div>
        </CardHeader>
        <CardContent className="flex flex-col gap-4">
          <MomentumBar value={n.momentum} side={n.side} size="lg" />
          <div class="flex flex-col gap-2.5">
            {
              parts.map((p) => (
                <div class="grid grid-cols-[6.5rem_1fr_2rem] items-center gap-2">
                  <span class="text-xs text-muted-foreground">{p.label}</span>
                  <Progress value={p.value} className="h-1.5" indicatorClassName="bg-foreground/70" aria-label={`${p.label} ${p.value}`} />
                  <span class="text-right font-mono text-xs tabular-nums">{Math.round(p.value)}</span>
                </div>
              ))
            }
          </div>
          <Separator />
          <dl class="grid grid-cols-2 gap-x-4 gap-y-4">
            <div><dt class={dt}>Posts, 24h</dt><dd class="mt-1 font-display text-3xl font-extrabold leading-none">{fmt(n.posts24h)}</dd></div>
            <div><dt class={dt}>Posts, ~7d</dt><dd class="mt-1 font-display text-3xl font-extrabold leading-none">{fmt(n.posts7d)}</dd></div>
            <div><dt class={dt}>Pace</dt><dd class="mt-1.5"><TrendInline accel={n.accel} className="text-sm" /><span class="block text-xs text-muted-foreground">vs {fmt(Math.round(n.priorDailyAvg))}/day prior</span></dd></div>
            <div><dt class={dt}>Outlets</dt><dd class="mt-1 font-display text-3xl font-extrabold leading-none">{n.outlets}</dd></div>
            <div class="col-span-2"><dt class={dt}>Sentiment</dt><dd class="mt-1 text-sm font-medium">{n.sentiment}</dd></div>
          </dl>
        </CardContent>
      </Card>
      <a href={historyPath(historySlug)} class="inline-flex items-center justify-center gap-1.5 rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        <History className="size-4" /> Full history: first sighting to now
      </a>
      <a href="/about" class="px-1 text-xs text-muted-foreground underline-offset-4 hover:text-primary hover:underline">How the momentum score is built →</a>
    </div>
  </aside>

  <article class="flex min-w-0 flex-col gap-8 lg:order-1">
    <section class="flex flex-col gap-4">
      <p class="text-lg leading-relaxed text-foreground/90">{n.summary}</p>
      <div class="flex gap-3 rounded-lg border-l-2 border-primary/60 bg-muted/50 px-4 py-3 text-sm leading-relaxed text-muted-foreground">
        <Quote className="mt-0.5 size-4 shrink-0 text-primary" />
        <p>{n.sentimentNote}</p>
      </div>
    </section>

    <Card className="px-5">
      <StoryCharts client:visible narrative={n} dailyCaption={snapshot.dailyChartCaption} />
    </Card>

    <section class="flex flex-col gap-4" aria-labelledby="tp">
      <h2 id="tp" class={`${h2} flex items-center gap-2`}><Megaphone className="size-5 text-primary" /> Talking points</h2>
      <ol class="flex flex-col gap-2.5">
        {
          n.talkingPoints.map((point, i) => (
            <li class="flex gap-4 rounded-lg border bg-card px-4 py-3">
              <span class="font-display text-2xl font-extrabold leading-none text-primary">{i + 1}</span>
              <span class="leading-relaxed">{point}</span>
            </li>
          ))
        }
      </ol>
      <p class="text-sm leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">Who is amplifying it: </span>{n.amplifiers}</p>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="fc">
      <h2 id="fc" class={`${h2} flex items-center gap-2`}><ShieldAlert className="size-5 text-primary" /> Fact-checks</h2>
      {
        n.factChecks.length > 0 ? (
          n.factChecks.map((f) => (
            <Card className="gap-3 py-4">
              <CardHeader className="gap-2 px-4">
                <div class="flex flex-wrap items-center gap-2">
                  <Badge variant={ratingVariant(f.rating)}>{f.rating}</Badge>
                  <span class="font-mono text-xs text-muted-foreground">{f.outlet}</span>
                </div>
                <p class="font-semibold leading-snug">“{f.claim.replace(/^["“']+|["”']+$/g, "")}”</p>
              </CardHeader>
              <CardContent className="px-4 text-sm leading-relaxed text-muted-foreground">
                <p>{f.detail}</p>
                <a href={f.href} target="_blank" rel="noreferrer noopener" class="mt-2 inline-flex items-center gap-1 font-medium text-primary hover:underline">
                  Open the fact-check <ExternalLink className="size-3.5" />
                </a>
              </CardContent>
            </Card>
          ))
        ) : (
          <p class="rounded-lg border border-dashed px-4 py-3 text-sm text-muted-foreground">{snapshot.noFactCheckNote}</p>
        )
      }
    </section>

    <section class="grid gap-4 md:grid-cols-2" aria-label="Why it works">
      <Card className="gap-3">
        <CardHeader><CardTitle className="flex items-center gap-2 text-lg"><Target className="size-4 text-primary" /> Why it works</CardTitle></CardHeader>
        <CardContent className="text-sm leading-relaxed text-muted-foreground">{n.whyItWorks}</CardContent>
      </Card>
      <Card className="gap-3">
        <CardHeader><CardTitle className="flex items-center gap-2 text-lg"><Users className="size-4 text-primary" /> Who it resonates with</CardTitle></CardHeader>
        <CardContent className="text-sm leading-relaxed text-muted-foreground">{n.audience}</CardContent>
      </Card>
    </section>

    <section class="rounded-xl bg-primary p-5 text-primary-foreground sm:p-6" aria-labelledby="counter">
      <h2 id="counter" class="font-display text-2xl font-extrabold uppercase tracking-wide">TDDR counter-angle</h2>
      <p class="mt-2 text-base font-medium leading-relaxed sm:text-lg">{n.counter}</p>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="src">
      <h2 id="src" class={h2}>Sources</h2>
      <ul class="flex flex-col divide-y rounded-xl border bg-card">
        {
          n.sources.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noreferrer noopener" class="group flex items-start justify-between gap-4 px-4 py-3 transition-colors hover:bg-muted/60">
                <span>
                  <span class="block text-sm font-medium group-hover:text-primary">{s.title}</span>
                  {s.site || s.date ? <span class="font-mono text-xs text-muted-foreground">{[s.site, s.date].filter(Boolean).join(" · ")}</span> : null}
                </span>
                <ExternalLink className="mt-0.5 size-4 shrink-0 text-muted-foreground" />
              </a>
            </li>
          ))
        }
      </ul>
      <details class="group mt-2">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground">
          <Search className="size-3.5" /> X query used for counts
        </summary>
        <pre class="mt-2 overflow-x-auto whitespace-pre-wrap break-words rounded-lg border bg-muted/50 p-3 font-mono text-xs text-muted-foreground">{n.query}</pre>
      </details>
    </section>
  </article>
</div>

<Separator className="mt-14" />
<nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="More narratives">
  {
    higher ? (
      <a href={narrativePath(snapshot.id, higher.id)} class="group rounded-xl border bg-card p-4 transition-colors hover:border-primary/50">
        <span class="flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-muted-foreground"><ArrowLeft className="size-3.5" /> #{rank - 1} · Higher momentum</span>
        <span class="mt-2 flex items-center gap-2"><SideBadge side={higher.side} /><span class="font-mono text-xs">{higher.momentum}</span></span>
        <span class="mt-2 block font-semibold leading-snug group-hover:text-primary">{stripNewPrefix(higher.title)}</span>
      </a>
    ) : <span class="hidden sm:block" />
  }
  {
    lower ? (
      <a href={narrativePath(snapshot.id, lower.id)} class="group rounded-xl border bg-card p-4 text-right transition-colors hover:border-primary/50">
        <span class="flex items-center justify-end gap-1.5 font-mono text-[0.7rem] uppercase tracking-widest text-muted-foreground">#{rank + 1} · Lower momentum <ArrowRight className="size-3.5" /></span>
        <span class="mt-2 flex items-center justify-end gap-2"><span class="font-mono text-xs">{lower.momentum}</span><SideBadge side={lower.side} /></span>
        <span class="mt-2 block font-semibold leading-snug group-hover:text-primary">{stripNewPrefix(lower.title)}</span>
      </a>
    ) : null
  }
</nav>
