---
import { ExternalLink } from "lucide-react";
import type { SourceLink } from "../../data/schema";

interface Props {
  links: SourceLink[];
  numbered?: boolean;
  columns?: boolean;
}

const { links, numbered = false, columns = false } = Astro.props;
---

<ol class:list={["divide-y rounded-xl border bg-card", columns && "md:grid md:grid-cols-2 md:divide-y-0"]}>
  {
    links.map((link, i) => (
      <li class:list={[columns && "md:border-b"]}>
        <a href={link.href} target="_blank" rel="noreferrer noopener" class="group flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/60">
          {numbered ? <span class="w-6 shrink-0 pt-0.5 font-mono text-xs text-muted-foreground">{String(i + 1).padStart(2, "0")}</span> : null}
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium group-hover:text-primary">{link.title}</span>
            {link.site || link.date ? <span class="font-mono text-xs text-muted-foreground">{[link.site, link.date].filter(Boolean).join(" · ")}</span> : null}
          </span>
          <ExternalLink className="mt-0.5 size-4 shrink-0 text-muted-foreground" />
        </a>
      </li>
    ))
  }
</ol>
