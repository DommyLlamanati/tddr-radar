---
import type { HistoryIndex, NarrativeHistory } from "../../lib/history";
import { historyPath, snapshotShortLabel } from "../../lib/history";
import HistoryChart from "./HistoryChart";
import MatchingNote from "./MatchingNote.astro";
import { MomentumScore, NewBadge, SideBadge, StatusBadge } from "./bits";
import { stripNewPrefix } from "../../lib/share";

interface Props {
  index: HistoryIndex;
}

const { index } = Astro.props;
const live = index.histories.filter((h) => h.current);
const gone = index.histories.filter((h) => !h.current);
const groups: { id: string; title: string; dek: string; items: NarrativeHistory[] }[] = [
  { id: "live", title: "On the board now", dek: "In the latest snapshot, ordered by current momentum.", items: live },
  { id: "gone", title: "Dropped off", dek: "Not in the latest snapshot, most recently seen first.", items: gone },
];
---

<section class="flex flex-col gap-4" aria-labelledby="page-title">
  <span class="font-mono text-[0.7rem] uppercase tracking-widest text-primary">Narrative history</span>
  <h1 id="page-title" class="font-display text-5xl font-extrabold uppercase leading-[0.9] tracking-tight sm:text-7xl">
    First sighting<br /><span class="text-primary">to fade</span>
  </h1>
  <p class="max-w-2xl text-muted-foreground">
    Every narrative TDDR Radar has tracked, followed across all {index.snapshots.length} morning and evening snapshots
    ({snapshotShortLabel(index.snapshots[0].id)} → {snapshotShortLabel(index.snapshots[index.snapshots.length - 1].id)}).
    {index.histories.length} narratives, {live.length} on the board now.
  </p>
</section>

{
  groups.map((g) => (
    <section class="mt-12" aria-labelledby={`g-${g.id}`}>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id={`g-${g.id}`} class="font-display text-3xl font-extrabold uppercase tracking-wide">
          {g.title} <span class="font-mono text-sm text-muted-foreground">{g.items.length}</span>
        </h2>
        <p class="text-sm text-muted-foreground">{g.dek}</p>
      </div>
      <ol class="flex flex-col overflow-hidden rounded-xl border bg-card">
        {g.items.map((h) => (
          <li class="border-b last:border-b-0">
            <a href={historyPath(h.slug)} class="group grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 px-4 py-4 transition-colors hover:bg-muted/60 sm:grid-cols-[1fr_10rem_9rem_4.5rem] sm:px-5">
              <span class="min-w-0">
                <span class="mb-1.5 flex flex-wrap items-center gap-1.5">
                  <SideBadge side={h.side} />
                  {h.isNew ? <NewBadge /> : null}
                  <StatusBadge status={h.status} />
                </span>
                <span class="block font-semibold leading-snug group-hover:text-primary">{stripNewPrefix(h.title)}</span>
                <span class="mt-1 block font-mono text-[0.7rem] text-muted-foreground">
                  First {snapshotShortLabel(h.first.snapshotId)} · peak {h.peak.momentum} {snapshotShortLabel(h.peak.snapshotId)} · {h.appearances.length} snapshot{h.appearances.length === 1 ? "" : "s"}
                  {h.current ? "" : ` · last ${snapshotShortLabel(h.last.snapshotId)}`}
                </span>
              </span>
              <span class="hidden sm:block">
                <HistoryChart history={h} snapshots={index.snapshots} compact />
              </span>
              <span class="hidden flex-col sm:flex">
                <span class="font-mono text-[0.65rem] uppercase tracking-wider text-muted-foreground">{h.current ? "Now" : "Last"} / peak</span>
                <span class="font-mono text-sm">{h.last.momentum} / <span class="text-primary">{h.peak.momentum}</span></span>
              </span>
              <span class="flex flex-col items-end">
                <MomentumScore value={h.last.momentum} className={`text-3xl ${h.current ? "" : "text-muted-foreground"}`} />
                <span class="font-mono text-[0.6rem] uppercase tracking-wider text-muted-foreground sm:hidden">peak {h.peak.momentum}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<div class="mt-10"><MatchingNote /></div>
