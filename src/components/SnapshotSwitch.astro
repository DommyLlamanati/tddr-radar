---
import { allSnapshots } from "../lib/snapshots";
import { dashboardPath, snapshotSwitchLabel } from "../lib/dates";

interface Props {
  activeId: string;
}

const snapshots = await allSnapshots();
const ids = snapshots.map((entry) => entry.data.id);
const latestId = ids[0];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function onDay(id: string): boolean {
  if (path === "/snapshots") return false;
  if (path === `/snapshots/${id}` || path.startsWith(`/snapshots/${id}/`)) return true;
  return id === latestId && (path === "/" || path === "/disinfo" || path.startsWith("/narratives"));
}
---

<nav class="day-switch" aria-label="Snapshots">
  {
    snapshots.map((entry, index) => {
      const id = entry.data.id;
      return (
        <a href={dashboardPath(id, latestId)} aria-current={onDay(id) ? "page" : undefined}>
          {snapshotSwitchLabel(ids, index)}
        </a>
      );
    })
  }
  <a href="/snapshots" aria-current={path === "/snapshots" ? "page" : undefined}>
    Archive
  </a>
</nav>
