---
import type { Snapshot } from "../data/schema";
import SourceList from "./SourceList.astro";
import SnapshotSwitch from "./SnapshotSwitch.astro";
import DisinfoTracker from "./DisinfoTracker";

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const narrativeBase = `/snapshots/${snapshot.id}/narratives`;
const items = snapshot.narratives.flatMap((narrative) =>
  narrative.factChecks.map((fact) => ({
    narrativeId: narrative.id,
    narrativeTitle: narrative.title,
    side: narrative.side,
    claim: fact.claim,
    rating: fact.rating,
    detail: fact.detail,
    href: fact.href,
    outlet: fact.outlet,
  })),
);
---

<p class="eyebrow">{snapshot.updatedLabel}</p>
<h1>Disinformation tracker</h1>
<p class="lede">{snapshot.disinfo.caption}</p>
<SnapshotSwitch activeId={snapshot.id} />
<DisinfoTracker client:load items={items} narrativeBase={narrativeBase} />
<aside class="callout warning">
  <p class="callout-lead">{snapshot.disinfo.caveatLead}</p>
  <p>{snapshot.disinfo.caveatBody}</p>
</aside>
<div class="section-head">
  <h2>Fact-check sources</h2>
</div>
<SourceList links={snapshot.disinfo.links} />
<p class="note">Each claim links to its narrative inside the {snapshot.id} snapshot.</p>
