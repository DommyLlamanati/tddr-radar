---
import Base from "../../../../layouts/Base.astro";
import { narrativeShare, ogImagePath } from "../../../../lib/share";
import NarrativePage from "../../../../components/NarrativePage.astro";
import { allSnapshots } from "../../../../lib/snapshots";

export async function getStaticPaths() {
  const snapshots = await allSnapshots();
  return snapshots.flatMap((entry) => {
    const ranked = [...entry.data.narratives].sort((a, b) => b.momentum - a.momentum);
    return ranked.map((narrative, index) => ({
      params: { date: entry.data.id, id: narrative.id },
      props: {
        snapshot: entry.data,
        narrative,
        rank: index + 1,
        total: ranked.length,
        higher: index > 0 ? ranked[index - 1] : null,
        lower: index < ranked.length - 1 ? ranked[index + 1] : null,
      },
    }));
  });
}

const { snapshot, narrative, rank, total, higher, lower } = Astro.props;
const share = narrativeShare(snapshot, narrative);
---

<Base
  title={narrative.title}
  description={share.description}
  shareTitle={share.title}
  image={ogImagePath(snapshot.id)}
  imageAlt={`TDDR Radar: ${narrative.side} narrative, momentum ${narrative.momentum}.`}
  ogType="article"
  snapshotId={snapshot.id}
>
  <NarrativePage
    snapshot={snapshot}
    narrative={narrative}
    rank={rank}
    total={total}
    higher={higher}
    lower={lower}
  />
</Base>
