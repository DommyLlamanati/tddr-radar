---
import Radar from "../../layouts/Radar.astro";
import HomeView from "../../components/radar/HomeView.astro";
import { allSnapshots } from "../../lib/snapshots";
import { editionLabel, ogImagePath, rankedNarratives, shortTitle, snapshotShare } from "../../lib/share";

export async function getStaticPaths() {
  const snapshots = await allSnapshots();
  return snapshots.map((entry) => ({
    params: { date: entry.data.id },
    props: { snapshot: entry.data },
  }));
}

const { snapshot } = Astro.props;
const isLatest = (await allSnapshots())[0]?.data.id === snapshot.id;
const share = snapshotShare(snapshot);
const top = rankedNarratives(snapshot)[0];
const imageAlt = `TDDR Radar, ${editionLabel(snapshot.id)}: top rising narrative, ${shortTitle(top.title)} (${top.side}, momentum ${top.momentum}).`;
---

<Radar
  title={snapshot.title}
  description={share.description}
  shareTitle={share.title}
  image={ogImagePath(snapshot.id)}
  imageAlt={imageAlt}
  ogType="article"
  snapshotId={snapshot.id}
>
  <HomeView snapshot={snapshot} isLatest={isLatest} />
</Radar>
