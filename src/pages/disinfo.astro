---
import Radar from "../layouts/Radar.astro";
import { disinfoShare, editionLabel, factCheckTotal, ogDisinfoImagePath } from "../lib/share";
import DisinfoView from "../components/radar/DisinfoView.astro";
import { latestSnapshot } from "../lib/snapshots";

const snapshot = (await latestSnapshot()).data;
const share = disinfoShare(snapshot);
const imageAlt = `TDDR Radar disinformation tracker, ${editionLabel(snapshot.id)}: ${factCheckTotal(snapshot)} fact-checks.`;
---

<Radar
  title="Disinformation tracker"
  description={share.description}
  shareTitle={share.title}
  image={ogDisinfoImagePath(snapshot.id)}
  imageAlt={imageAlt}
  snapshotId={snapshot.id}
>
  <DisinfoView snapshot={snapshot} />
</Radar>
