---
import Radar from "../../layouts/Radar.astro";
import { narrativeShare, ogNarrativeImagePath } from "../../lib/share";
import StoryView from "../../components/radar/StoryView.astro";
import { latestSnapshot } from "../../lib/snapshots";

export async function getStaticPaths() {
  const snapshot = (await latestSnapshot()).data;
  const ranked = [...snapshot.narratives].sort((a, b) => b.momentum - a.momentum);
  return ranked.map((narrative, index) => ({
    params: { id: narrative.id },
    props: {
      snapshot,
      narrative,
      rank: index + 1,
      total: ranked.length,
      higher: index > 0 ? ranked[index - 1] : null,
      lower: index < ranked.length - 1 ? ranked[index + 1] : null,
    },
  }));
}

const { snapshot, narrative, rank, total, higher, lower } = Astro.props;
const share = narrativeShare(snapshot, narrative);
---

<Radar
  title={narrative.title}
  description={share.description}
  shareTitle={share.title}
  image={ogNarrativeImagePath(snapshot.id, narrative.id)}
  imageAlt={share.imageAlt}
  ogType="article"
  snapshotId={snapshot.id}
>
  <StoryView
    snapshot={snapshot}
    narrative={narrative}
    rank={rank}
    total={total}
    higher={higher}
    lower={lower}
  />
</Radar>
